{% extends "base.html.twig" %}
{% block title %}
{{ parent() }} - Home
{% endblock %}

{% block content %}

<div class="container-xxl bg-white p-0">
    <!-- Spinner Start -->
    {% include 'includes/spinner.html.twig' %}
    <!-- Spinner End -->
    <!-- Header Start -->
    {% include 'includes/header.html.twig' %}
    <!-- Header End -->
    <!-- Search Start -->
    {{ render(controller('App\\Controller\\PropertySearchController::searchProperty')) }}

    <!-- Search End -->
    <!-- Category Start -->
    {{ render(controller('App\\Controller\\PropertyTypeController::typeSection')) }}

    <!-- Category End -->
    <!-- About Start -->
    {% include 'includes/about.html.twig' %}

    <!-- About End -->


    <!-- Property List Start -->
    {% include 'includes/properties.html.twig' with { properties: properties } %}

    <!-- Property List End -->


    <!-- Call to Action Start -->
    {% include 'includes/callToAction.html.twig' %}

    <!-- Call to Action End -->
    <!-- Team Start -->
    {% include 'includes/team.html.twig' %}
    <!-- Team End -->
    <!-- Testimonial Start -->
    {% include 'includes/testimonial.html.twig' %}
    <!-- Testimonial End -->


    <!-- Back to Top -->
    <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
</div>
<!-- JavaScript Libraries -->
{% endblock %}