<div class="container-fluid bg-primary mb-5 wow fadeIn" data-wow-delay="0.1s" style="padding: 35px;">
    <div class="container">
        {{ form_start(form, {
        attr: {
        method: 'GET',
        class : 'row g-2 align-items-end', 
        action: path('app_search'),
        enctype: 'multipart/form-data'
        }
        }) }}
        <div class="col-md-4">
            {{ form_row(form.title, {
            attr: { class: 'form-control border-0 py-3' }
            }) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.type, {
            attr: { class: 'form-control border-0 py-3' }
            }) }}
        </div>
        <div class="col-md-2">
            {{ form_row(form.purpose, {
            attr: { class: 'form-control border-0 py-3' }
            }) }}
        </div>
        <div class="col-md-2">
            <button class="btn btn-dark border-0 w-100 py-3 mb-3">Search</button>
        </div>
        {{ form_end(form) }}

    </div>
</div>

{% if properties is defined %}
<h2>Results:</h2>
{{dump(properties)}}
{% if properties|length > 0 %}
<ul>
    {% for property in properties %}
    <li>{{ property.title }} - {{ property.type.name }} - {{ property.purpose }}</li>
    {% endfor %}
</ul>
{% else %}
<p>No properties found.</p>
{% endif %}
{% endif %}