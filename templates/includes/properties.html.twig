{%import 'marcos/_property.html.twig' as propertyMacros %}
<div class="container-xxl py-5">
    <div class="container">
        <!-- Properties name and description Start -->
        <div class="row g-0 gx-5 align-items-end">
            <div class="col-lg-6">
                <div class="text-start mx-auto mb-5 wow slideInLeft" data-wow-delay="0.1s">
                    <h1 class="mb-3">Property Listing</h1>
                    <p>Eirmod sed ipsum dolor sit rebum labore magna erat. Tempor ut dolore lorem kasd vero ipsum
                        sit eirmod sit diam justo sed rebum.</p>
                </div>
            </div>
            {{ include('includes/_fillter_property.html.twig') }}
        </div>
        <!-- Properties name and description end -->
        <!-- Properties list Start -->
        <div class="tab-content">
            <!-- Properties list Start id=1-->
            <div id="tab-1" class="tab-pane fade show p-0 active">
                <ul class="row g-4">
                    <!-- Properties  row start -->
                    {% for property in properties|slice(0, 6) %}
                    {{ propertyMacros.property(property) }}
                    {% endfor %}
                    <!-- Properties  read more start -->
                    <div class="col-12 text-center wow fadeInUp" data-wow-delay="0.1s">
                        <a class="btn btn-primary py-3 px-5" href="{{path('properties')}}">Browse More Property</a>
                    </div>
                    <!-- Properties  read more end -->
                    <!-- Properties  row end -->

                </ul>
            </div>
        </div>
        <!-- Properties list end -->

    </div>
</div>