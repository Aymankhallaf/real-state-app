{% macro property(property) %}
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                <div class="">
                    {% set image = property.images|first %}
                    {% if image %}
                    <img class="img-fluid w-100 mb-3" src="{{ asset(image.webPath) }}" alt="{{ image.alt }}">
                    {% else %}
                    <img class="img-fluid w-100 mb-3" src="{{ asset('img/property-1.jpg') }}" alt="Default image">
                    {% endif %}

                    {% if property.images|length > 1 %}
                    <div class="row">
                        {% for img in property.images|slice(1) %}
                        <div class="col-4 mb-2">
                            <img class="img-fluid" src="{{ asset(img.webPath) }}" alt="{{ img.alt }}">
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <h1 class="mb-4">{{ property.title }}</h1>
                <p class="mb-4">{{ property.description }}</p>
                <p><i class="fa fa-map-marker-alt text-primary me-3"></i>{{ property.address }}</p>
                <p><i class="fa fa-ruler-combined text-primary me-3"></i>{{ property.area }} Sqft</p>
                <p><i class="fa fa-bed text-primary me-3"></i>{{ property.room }} rooms</p>
                <p><i class="fa fa-bed text-primary me-3"></i>{{ property.bed }} bedrooms</p>
                <p><i class="fa fa-bath text-primary me-3"></i>{{ property.Bathroom }} bathrooms</p>

                {% if is_granted('ROLE_ADMIN') %}
                <a class="btn btn-warning py-3 px-5 mt-3"
                    href="{{ path('property_edit', {'id': property.id}) }}">Edit</a>
                <a class="btn btn-danger py-3 px-5 mt-3"
                    href="{{ path('property_delete', {'id': property.id}) }}">Delete</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endmacro %}