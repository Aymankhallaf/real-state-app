    {%macro type(type) %}
    <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
        <a class="cat-item d-block bg-light text-center rounded p-3" href="path('property_type_show', {'name': type.name})">
            <div class="rounded p-4">
                <div class="icon mb-3">
                    <img class="img-fluid" src="uploads/images/{{type.getImgUrl()}}" alt="{{type.getImgAlt()}}">
                </div>
                <h6>{{type.getName()}}</h6>
                <span>{{ type.properties|length }} Properties</span>
            </div>
        </a>
    </div> 
    {% endmacro%}
