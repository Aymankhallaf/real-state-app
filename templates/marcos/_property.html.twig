{%macro property (property)%}
<li class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
    <div class="property-item rounded overflow-hidden">
        <div class="position-relative overflow-hidden">
            {% set image = property.images|first %}
            {% if image %}
            <img class="img-fluid" src="{{ asset(image.webPath) }}" alt="{{ image.alt }}">
            {% else %}
            <img class="img-fluid" src="{{ asset('img/property-1.jpg') }}" alt="Default image">
            {% endif %}
            <div class="bg-primary rounded text-white position-absolute start-0 top-0 m-4 py-1 px-3">
                {{property.purpose}}</div>
            <div class="bg-white rounded-top text-primary position-absolute start-0 bottom-0 mx-4 pt-1 px-3">
                {{property.type.name}}</div>
        </div>
        <div class="p-4 pb-0">
            <h5 class="text-primary mb-3">$ {{property.price|number_format(0, '.', ',')}}</h5>
            <a class="d-block h5 mb-2" href="{{path('property_show',{'id':property.id})}}">{{property.title}}</a>
            <p><i class="fa fa-map-marker-alt text-primary me-2"></i>{{property.address}}</p>
        </div>
        <div class="d-flex border-top">
            <small class="flex-fill text-center border-end py-2"><i
                    class="fa fa-ruler-combined text-primary me-2"></i>{{property.area}} Sqft</small>
            <small class="flex-fill text-center border-end py-2"><i
                    class="fa fa-bed text-primary me-2"></i>{{property.bed}} Bed</small>
            <small class="flex-fill text-center py-2"><i class="fa fa-bath text-primary me-2"></i>{{property.Bathroom}}
                Bath</small>
        </div>
    </div>
</li>
{% endmacro%}