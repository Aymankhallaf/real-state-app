{% extends "base.html.twig" %}
{% block title %}
{{ parent() }} - Delete Property
{% endblock %}
{% block content %}

<div class="container-xxl bg-white p-0">
    <div class="container-xxl py-5">
        <h1 class="mb-4">Delete </h1>
        <p>Are you sure you want to delete this property {{property.title}}</p>
        <div class="container">
            <form action="post">
                <button class="btn btn-danger"> Delete</button>
                <a href="{{ path('property_show', {'id': property.id} )}}" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

{% endblock %}