{%import 'marcos/_property.html.twig' as property %}
{% extends "base.html.twig" %}
{% block title %}
{{ parent() }} - Properties
{% endblock %}
{% block content %}
<div class="container-xxl bg-white p-0">
    <div class="container-xxl py-5">
        <div class="container">
            {{ render(controller('App\\Controller\\PropertySearchController::searchProperty')) }}

            <div class="row g-0 gx-5 align-items-end">
                <div class="col-lg-6">
                    <div class="text-start mx-auto mb-5 wow slideInLeft" data-wow-delay="0.1s">
                        <h1 class="mb-3">Property Listing</h1>
                        <p>Eirmod sed ipsum dolor sit rebum labore magna erat. Tempor ut dolore lorem kasd vero ipsum
                            sit eirmod sit diam justo sed rebum.</p>
                    </div>
                </div>
            {{ include('includes/_fillter_property.html.twig') }}

            </div>
            {% for property in properties %}
            {% if loop.index0 % 3 == 0 %}
            <div id="tab-1" class="tab-pane fade show p-0 active">
                <div class="row g-4">
                    {% endif %}
                    {{property.property(property)}}

                    {% if loop.index0 % 3 == 2 or loop.last %}
                </div>
            </div>
            {% endif %}
            {% endfor %}
        </div>
    </div>
</div>

{% endblock %}